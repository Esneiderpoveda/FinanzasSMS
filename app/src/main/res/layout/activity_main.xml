<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">


    <!-- Barra superior y menú hamburguesa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#242424"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/botonMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:contentDescription="Abrir menú"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rastreador de Gastos"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tarjeta de saldo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo total"
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/textSaldoTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Permisos SMS -->
        <TextView
            android:id="@+id/textEstadoPermisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando permisos..."
            android:textSize="13sp"
            android:textColor="#616161"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/botonSolicitarPermisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitar permisos de SMS"
            android:layout_marginBottom="16dp" />



        <!-- Gestión de saldo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Ajustar saldo y resetear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/botonAjustarSaldo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/fondo_boton_secundario"
                    android:backgroundTint="@null"
                    android:text="Ajustar saldo"
                    android:textColor="#172B4D"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/botonResetear"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_boton_secundario"
                    android:backgroundTint="@null"
                    android:text="Resetear todo"
                    android:textColor="#172B4D"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Actualizar movimientos -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/botonActualizar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/fondo_boton_principal"
                android:backgroundTint="@null"
                android:text="↻  Actualizar movimientos"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>



        <!-- Historial -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos movimientos"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistorial"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Botón volver -->
        <TextView
            android:id="@+id/botonVolverAhorro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐷 Calculadora de ahorro"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="10dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcula cuánto dinero puedes acumular ahorrando una cantidad fija cada mes."
            android:textSize="15sp"
            android:textColor="#607080"
            android:layout_marginBottom="25dp" />

        <!-- Etiqueta ahorro mensual -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Cuánto ahorrarás cada mes? (COP)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="8dp" />

        <!-- Campo ahorro mensual -->
        <EditText
            android:id="@+id/inputAhorroMensual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ejemplo: 150000"
            android:inputType="number"
            android:padding="14dp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="24dp" />

        <!-- Etiqueta meses -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Durante cuántos meses?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="8dp" />

        <!-- Campo meses -->
        <EditText
            android:id="@+id/inputMesesAhorro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ejemplo: 24"
            android:inputType="number"
            android:padding="14dp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="24dp" />

        <!-- Botón calcular -->
        <Button
            android:id="@+id/botonCalcularAhorro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular ahorro"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="25dp" />

        <!-- Resultado -->
        <TextView
            android:id="@+id/textResultadoAhorro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu resultado aparecerá aquí"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#16803C"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:elevation="3dp" />

        <!-- Aclaración -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este cálculo no incluye intereses ni rendimientos."
            android:textSize="13sp"
            android:textColor="#607080"
            android:gravity="center"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>
